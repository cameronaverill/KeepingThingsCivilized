# Copy this file to .env and fill it in. .env is never committed to git.
# Real environment variables always win over values in .env.

# --- Anthropic ---
# Create this key INSIDE the dedicated Console workspace that has a monthly spend limit (docs/plan.md, section 3.1).
ANTHROPIC_API_KEY=

# --- Django ---
# "development" (default) or "production". A deployed site MUST set production.
DJANGO_ENV=development
# Required when DJANGO_ENV=production. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated host names. Required when DJANGO_ENV=production; localhost is allowed by default in development.
DJANGO_ALLOWED_HOSTS=
# Comma-separated https://... origins, if the site is served from a different origin than its host name.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Where the SQLite file lives. Defaults to db.sqlite3 in the project folder; point at a persistent disk in production.
DJANGO_DB_PATH=

# --- Email (step 6) ---
# Development prints emails to the terminal. Real SMTP options are added in step 6.
# (This is our own variable name; it feeds Django 6.1's MAILERS setting.)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=forum@localhost

# --- Alerts ---
# The address that gets one email when the AI moderator pauses itself (spend limit, rejected API key, repeated API
# errors). Leave blank for no email. Put your own address here in .env, not in this file.
ALERT_EMAIL=
